From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: botoddly <250804054+botoddly@users.noreply.github.com>
Date: Sat, 7 Nov 2026 09:58:11 +0100
Subject: [PATCH] library-name: Build the library as XDL3_image

---
 CMakeLists.txt         | 4 ++--
 cmake/sdl3-image.pc.in | 2 +-
 src/version.rc         | 2 +-
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 32448e4bbcde3d08817bf0c61f678c59d6465a8b..40bafec0fee83d2f0e600c25df4d07cb9ad8bfd5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -325,7 +325,7 @@ if(WIN32 AND SDLIMAGE_BUILD_SHARED_LIBS)
     endif()
 endif()
 set_target_properties(${sdl3_image_target_name} PROPERTIES
-    OUTPUT_NAME "SDL3_image"
+    OUTPUT_NAME "XDL3_image"
     DEFINE_SYMBOL DLL_EXPORT
     EXPORT_NAME ${sdl3_image_target_name}
     C_VISIBILITY_PRESET "hidden"
@@ -360,7 +360,7 @@ if(SDLIMAGE_BUILD_SHARED_LIBS)
 else()
     if(MSVC)
         set_target_properties(${sdl3_image_target_name} PROPERTIES
-            OUTPUT_NAME "SDL3_image-static"
+            OUTPUT_NAME "XDL3_image-static"
         )
     endif()
 endif()
diff --git a/cmake/sdl3-image.pc.in b/cmake/sdl3-image.pc.in
index ddd3768a0c20abdae773cf5f5862b89dd9e3bcba..9b4eb7120570a6686f92bc31a8bae6a76cbce083 100644
--- a/cmake/sdl3-image.pc.in
+++ b/cmake/sdl3-image.pc.in
@@ -7,7 +7,7 @@ Name: @PROJECT_NAME@
 Description: image loading library for Simple DirectMedia Layer
 Version: @PROJECT_VERSION@
 Requires: sdl3 >= @SDL_REQUIRED_VERSION@
-Libs: -L${libdir} -lSDL3_image
+Libs: -L${libdir} -lXDL3_image
 Requires.private: @PC_REQUIRES@
 Libs.private: @PC_LIBS@
 Cflags: -I${includedir}
diff --git a/src/version.rc b/src/version.rc
index 2438deadefdafd01eefe454c411dbe9dbee527da..f605890a624061fa00c958128f9dd30439b7f265 100644
--- a/src/version.rc
+++ b/src/version.rc
@@ -26,7 +26,7 @@ BEGIN
             VALUE "FileVersion", "3, 4, 8, 0\0"
             VALUE "InternalName", "SDL_image\0"
             VALUE "LegalCopyright", "Copyright (C) 2026 Sam Lantinga\0"
-            VALUE "OriginalFilename", "SDL3_image.dll\0"
+            VALUE "OriginalFilename", "XDL3_image.dll\0"
             VALUE "ProductName", "Simple DirectMedia Layer\0"
             VALUE "ProductVersion", "3, 4, 8, 0\0"
         END
