From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: botoddly <250804054+botoddly@users.noreply.github.com>
Date: Sat, 7 Nov 2026 09:58:12 +0100
Subject: [PATCH] library-name: Build the library as XDL3_mixer

---
 CMakeLists.txt         | 4 ++--
 cmake/sdl3-mixer.pc.in | 2 +-
 src/version.rc         | 2 +-
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a0910c7028b3004d9c476749db9dbe2fcc5c8d32..663a67d8e4cf6193c569ebb1d77b93dec53a9fc6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -281,7 +281,7 @@ if(WIN32 AND BUILD_SHARED_LIBS)
     endif()
 endif()
 set_target_properties(${sdl3_mixer_target_name} PROPERTIES
-    OUTPUT_NAME "SDL3_mixer"
+    OUTPUT_NAME "XDL3_mixer"
     DEFINE_SYMBOL DLL_EXPORT
     EXPORT_NAME ${sdl3_mixer_target_name}
     C_VISIBILITY_PRESET "hidden"
@@ -315,7 +315,7 @@ if(SDLMIXER_BUILD_SHARED_LIBS)
 else()
     if(MSVC)
         set_target_properties(${sdl3_mixer_target_name} PROPERTIES
-            OUTPUT_NAME "SDL3_mixer-static"
+            OUTPUT_NAME "XDL3_mixer-static"
         )
     endif()
 endif()
diff --git a/cmake/sdl3-mixer.pc.in b/cmake/sdl3-mixer.pc.in
index 16a503e1693efbea0d21e0eae39ad1b747934539..3a2f15026c86397cf04ed7dd1901b6251f859f72 100644
--- a/cmake/sdl3-mixer.pc.in
+++ b/cmake/sdl3-mixer.pc.in
@@ -7,7 +7,7 @@ Name: @PROJECT_NAME@
 Description: mixer library for Simple DirectMedia Layer
 Version: @PROJECT_VERSION@
 Requires: sdl3 >= @SDL_REQUIRED_VERSION@
-Libs: -L${libdir} -lSDL3_mixer
+Libs: -L${libdir} -lXDL3_mixer
 Requires.private: @PC_REQUIRES@
 Libs.private: @PC_LIBS@
 Cflags: -I${includedir}
diff --git a/src/version.rc b/src/version.rc
index 910e5ac36e1ae87b3efbb734beb89841c292c2c5..905eb170b3a321cea87a04a1da79a4be0fa0c70a 100644
--- a/src/version.rc
+++ b/src/version.rc
@@ -26,7 +26,7 @@ BEGIN
             VALUE "FileVersion", "3, 2, 4, 0\0"
             VALUE "InternalName", "SDL_mixer\0"
             VALUE "LegalCopyright", "Copyright (C) 2026 Sam Lantinga\0"
-            VALUE "OriginalFilename", "SDL3_mixer.dll\0"
+            VALUE "OriginalFilename", "XDL3_mixer.dll\0"
             VALUE "ProductName", "Simple DirectMedia Layer\0"
             VALUE "ProductVersion", "3, 2, 4, 0\0"
         END
