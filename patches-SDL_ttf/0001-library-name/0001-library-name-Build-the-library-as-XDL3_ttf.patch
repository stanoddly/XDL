From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: botoddly <250804054+botoddly@users.noreply.github.com>
Date: Sat, 7 Nov 2026 09:58:11 +0100
Subject: [PATCH] library-name: Build the library as XDL3_ttf

---
 CMakeLists.txt       | 4 ++--
 cmake/sdl3-ttf.pc.in | 2 +-
 src/version.rc       | 2 +-
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 429bcb0da00c0ed8c9de6b219ee3dcaa095e3ce6..3536b48b77e78144e2b777d67d518a7f29ae6852 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -178,7 +178,7 @@ if(WIN32 AND SDLTTF_BUILD_SHARED_LIBS)
     endif()
 endif()
 set_target_properties(${sdl3_ttf_target_name} PROPERTIES
-    OUTPUT_NAME SDL3_ttf
+    OUTPUT_NAME XDL3_ttf
     DEFINE_SYMBOL DLL_EXPORT
     EXPORT_NAME ${sdl3_ttf_target_name}
     C_VISIBILITY_PRESET "hidden"
@@ -205,7 +205,7 @@ if(SDLTTF_BUILD_SHARED_LIBS)
 else()
     if(MSVC)
         set_target_properties(${sdl3_ttf_target_name} PROPERTIES
-            OUTPUT_NAME "SDL3_ttf-static"
+            OUTPUT_NAME "XDL3_ttf-static"
         )
     endif()
 endif()
diff --git a/cmake/sdl3-ttf.pc.in b/cmake/sdl3-ttf.pc.in
index 2e4361805ea09395be0b611b00bdd848d550d301..28e2a6df9bcc6e7fd5ebacd51c7a6e6cf03bebd2 100644
--- a/cmake/sdl3-ttf.pc.in
+++ b/cmake/sdl3-ttf.pc.in
@@ -7,7 +7,7 @@ Name: SDL3_ttf
 Description: ttf library for Simple DirectMedia Layer with FreeType 2 support
 Version: @PROJECT_VERSION@
 Requires: sdl3 >= @SDL_REQUIRED_VERSION@
-Libs: -L${libdir} -lSDL3_ttf
+Libs: -L${libdir} -lXDL3_ttf
 Requires.private: @PC_REQUIRES@
 Libs.private: @PC_LIBS@
 Cflags: -I${includedir}
diff --git a/src/version.rc b/src/version.rc
index b9f5cd52ee6144e1fbf6371a031a52764a623ea9..e7ee9158a62ee1fbf4ddab1070f3a659362127dc 100644
--- a/src/version.rc
+++ b/src/version.rc
@@ -26,7 +26,7 @@ BEGIN
             VALUE "FileVersion", "3, 2, 2, 0\0"
             VALUE "InternalName", "SDL_ttf\0"
             VALUE "LegalCopyright", "Copyright (C) 2025 Sam Lantinga\0"
-            VALUE "OriginalFilename", "SDL3_ttf.dll\0"
+            VALUE "OriginalFilename", "XDL3_ttf.dll\0"
             VALUE "ProductName", "Simple DirectMedia Layer\0"
             VALUE "ProductVersion", "3, 2, 2, 0\0"
         END
