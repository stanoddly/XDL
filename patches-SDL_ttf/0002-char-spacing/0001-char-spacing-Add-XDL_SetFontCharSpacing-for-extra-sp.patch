From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: botoddly <250804054+botoddly@users.noreply.github.com>
Date: Tue, 10 Nov 2026 12:58:11 +0100
Subject: [PATCH] char-spacing: Add XDL_SetFontCharSpacing for extra space
 after each character

---
 CMakeLists.txt             |  1 +
 include/SDL3_ttf/XDL_ttf.h | 68 ++++++++++++++++++++++++++++++++++++++
 src/SDL_ttf.c              | 32 ++++++++++++++++--
 src/SDL_ttf.sym            |  1 +
 4 files changed, 100 insertions(+), 2 deletions(-)
 create mode 100644 include/SDL3_ttf/XDL_ttf.h

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3536b48b77e78144e2b777d67d518a7f29ae6852..a9877ed7b75ca5e28cfa8aac0db186e7bb8029eb 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -426,6 +426,7 @@ if(SDLTTF_INSTALL)
     install(FILES
         "${CMAKE_CURRENT_SOURCE_DIR}/include/SDL3_ttf/SDL_textengine.h"
         "${CMAKE_CURRENT_SOURCE_DIR}/include/SDL3_ttf/SDL_ttf.h"
+        "${CMAKE_CURRENT_SOURCE_DIR}/include/SDL3_ttf/XDL_ttf.h"
         DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/SDL3_ttf" COMPONENT devel
     )
     if(BUILD_SHARED_LIBS)
diff --git a/include/SDL3_ttf/XDL_ttf.h b/include/SDL3_ttf/XDL_ttf.h
new file mode 100644
index 0000000000000000000000000000000000000000..4c18be149721152c7b1d5e70c9db5be3090f9e66
--- /dev/null
+++ b/include/SDL3_ttf/XDL_ttf.h
@@ -0,0 +1,68 @@
