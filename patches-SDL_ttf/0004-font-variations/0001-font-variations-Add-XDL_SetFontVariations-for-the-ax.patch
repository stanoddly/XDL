From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: botoddly <250804054+botoddly@users.noreply.github.com>
Date: Tue, 10 Nov 2026 12:59:55 +0100
Subject: [PATCH] font-variations: Add XDL_SetFontVariations for the axes of a
 variable font

---
 include/SDL3_ttf/XDL_ttf.h |  29 ++++++++++
 src/SDL_ttf.c              | 111 +++++++++++++++++++++++++++++++++----
 src/SDL_ttf.sym            |   1 +
 3 files changed, 131 insertions(+), 10 deletions(-)

diff --git a/include/SDL3_ttf/XDL_ttf.h b/include/SDL3_ttf/XDL_ttf.h
index 3e707b5e634a62126dc2c4482c37b3ddf489ef14..a3275c41c3ea2d2002259ced29d8ffcc989e8b7c 100644
--- a/include/SDL3_ttf/XDL_ttf.h
+++ b/include/SDL3_ttf/XDL_ttf.h
@@ -87,6 +87,35 @@ extern SDL_DECLSPEC bool SDLCALL XDL_SetFontCharSpacing(TTF_Font *font, float sp
  */
 extern SDL_DECLSPEC bool SDLCALL XDL_SetFontFeatures(TTF_Font *font, const char *features);
 
+/**
+ * Set the values of a variable font's axes.
+ *
+ * `variations` is a comma-separated list in HarfBuzz's variation syntax:
+ * `wght=600` sets the weight axis to 600, and `wght=300,wdth=87.5` sets the
+ * weight and width axes. A value outside an axis's range is clamped to it.
+ * An axis the list leaves out keeps the value of the named instance that
+ * TTF_PROP_FONT_CREATE_FACE_NUMBER selected, or the font's default. NULL or
+ * an empty string restores those values for every axis.
+ *
+ * The values replace the ones set before. On failure the font keeps its
+ * previous values. When the font has a `wght` axis, TTF_GetFontWeight()
+ * returns its new value. TTF_CopyFont() does not copy the values, so a copy
+ * renders, and reports the weight of, its own face.
+ *
+ * This updates the font's metrics and any TTF_Text objects using this font,
+ * and clears already generated glyphs, if any, from the cache.
+ *
+ * \param font the font to set the variations for.
+ * \param variations the axis values, or NULL for the defaults.
+ * \returns true on success or false on failure, such as an axis the font does
+ *          not have, a font without variation axes, or an SDL_ttf built
+ *          without HarfBuzz; call SDL_GetError() for more information.
+ *
+ * \threadsafety This function should be called on the thread that created the
+ *               font.
+ */
+extern SDL_DECLSPEC bool SDLCALL XDL_SetFontVariations(TTF_Font *font, const char *variations);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/SDL_ttf.c b/src/SDL_ttf.c
index 3b07ccb0f4f26f832991be0aee2deba72e4cb63e..30e08de8cc6c80dcd7248e35161945346469e8b8 100644
--- a/src/SDL_ttf.c
+++ b/src/SDL_ttf.c
@@ -34,6 +34,7 @@
 #include FT_TRUETYPE_IDS_H
 #include FT_TRUETYPE_TABLES_H
 #include FT_IMAGE_H
+#include FT_MULTIPLE_MASTERS_H
 
 /* Enable rendering with color
  * Freetype may need to be compiled with FT_CONFIG_OPTION_USE_PNG */
@@ -2139,7 +2140,6 @@ TTF_Font *TTF_OpenFontWithProperties(SDL_PropertiesID props)
     // Set the default font style
     if (existing_font) {
         font->style = existing_font->style;
-        font->weight = existing_font->weight;
         font->outline = existing_font->outline;
         font->ft_load_target = existing_font->ft_load_target;
         font->enable_kerning = existing_font->enable_kerning;
@@ -2148,16 +2148,17 @@ TTF_Font *TTF_OpenFontWithProperties(SDL_PropertiesID props)
         font->outline = 0;
         font->ft_load_target = FT_LOAD_TARGET_NORMAL;
         TTF_SetFontKerning(font, true);
+    }
 
-        // Retrieve the weight from the OS2 TrueType table
-        const TT_OS2 *os2_table = (const TT_OS2 *)FT_Get_Sfnt_Table(face, FT_SFNT_OS2);
-        if (os2_table != NULL && os2_table->usWeightClass != 0) {
-            font->weight = os2_table->usWeightClass;
-        } else if (face->style_flags & FT_STYLE_FLAG_BOLD) {
-            font->weight = TTF_FONT_WEIGHT_BOLD;
-        } else {
-            font->weight = TTF_FONT_WEIGHT_NORMAL;
-        }
+    /* Retrieve the weight from the OS2 TrueType table, also for a copy, which does not take the variations of
+     * XDL_SetFontVariations and so renders at the weight of its own face */
+    const TT_OS2 *os2_table = (const TT_OS2 *)FT_Get_Sfnt_Table(face, FT_SFNT_OS2);
+    if (os2_table != NULL && os2_table->usWeightClass != 0) {
+        font->weight = os2_table->usWeightClass;
+    } else if (face->style_flags & FT_STYLE_FLAG_BOLD) {
+        font->weight = TTF_FONT_WEIGHT_BOLD;
+    } else {
+        font->weight = TTF_FONT_WEIGHT_NORMAL;
     }
 
 #if TTF_USE_HARFBUZZ
@@ -6054,6 +6055,96 @@ bool XDL_SetFontFeatures(TTF_Font *font, const char *features)
 #endif
 }
 
+bool XDL_SetFontVariations(TTF_Font *font, const char *variations)
+{
+    TTF_CHECK_FONT(font, false);
+
+#if TTF_USE_HARFBUZZ
+    FT_Face face = font->face;
+    bool any = variations && *variations;
+    if (!FT_HAS_MULTIPLE_MASTERS(face)) {
+        return any ? SDL_SetError("Font has no variation axes") : true;
+    }
+
+    FT_MM_Var *mm_var = NULL;
+    FT_Error error = FT_Get_MM_Var(face, &mm_var);
+    if (error) {
+        return TTF_SetFTError("Couldn't get font variation axes", error);
+    }
+
+    bool result = false;
+    FT_Fixed *coords = (FT_Fixed *)SDL_malloc(mm_var->num_axis * sizeof(*coords));
+    if (!coords) {
+        goto done;
+    }
+
+    // Axes the list leaves out keep the values of the named instance that the face index selected, or the font's defaults
+    FT_UInt instance = (FT_UInt)(face->face_index >> 16);
+    for (FT_UInt i = 0; i < mm_var->num_axis; ++i) {
+        coords[i] = instance > 0 && instance <= mm_var->num_namedstyles ? mm_var->namedstyle[instance - 1].coords[i] : mm_var->axis[i].def;
+    }
+
+    if (any) {
+        const char *item = variations;
+        for (;;) {
+            const char *end = SDL_strchr(item, ',');
+            int length = (int)(end ? (size_t)(end - item) : SDL_strlen(item));
+            hb_variation_t variation;
+            if (!hb_variation_from_string(item, length, &variation) || SDL_isnanf(variation.value)) {
+                SDL_SetError("Couldn't parse font variation '%.*s'", length, item);
+                goto done;
+            }
+
+            FT_UInt axis = 0;
+            while (axis < mm_var->num_axis && mm_var->axis[axis].tag != variation.tag) {
+                ++axis;
+            }
+            if (axis == mm_var->num_axis) {
+                SDL_SetError("Font has no variation axis '%c%c%c%c'", (char)(variation.tag >> 24), (char)(variation.tag >> 16), (char)(variation.tag >> 8), (char)variation.tag);
+                goto done;
+            }
+
+            // Clamped in float first, so the conversion to 16.16 fixed point cannot overflow
+            const FT_Var_Axis *range = &mm_var->axis[axis];
+            float value = SDL_clamp(variation.value, (float)range->minimum / 65536.0f, (float)range->maximum / 65536.0f);
+            coords[axis] = SDL_clamp((FT_Fixed)SDL_roundf(value * 65536.0f), range->minimum, range->maximum);
+
+            if (!end) {
+                break;
+            }
+            item = end + 1;
+        }
+    }
+
+    error = FT_Set_Var_Design_Coordinates(face, mm_var->num_axis, coords);
+    if (error) {
+        TTF_SetFTError("Couldn't set font variations", error);
+        goto done;
+    }
+
+    for (FT_UInt i = 0; i < mm_var->num_axis; ++i) {
+        if (mm_var->axis[i].tag == HB_TAG('w','g','h','t')) {
+            font->weight = (int)SDL_roundf((float)coords[i] / 65536.0f);
+        }
+    }
+
+    TTF_InitFontMetrics(font);
+    Flush_Cache(font);
+    UpdateFontText(font, NULL);
+    // Reads the new coordinates from the FT_Face
+    hb_ft_font_changed(font->hb_font);
+    result = true;
+
+done:
+    SDL_free(coords);
+    FT_Done_MM_Var(TTF_state.library, mm_var);
+    return result;
+#else
+    (void)variations;
+    return SDL_Unsupported();
+#endif
+}
+
 Uint32 TTF_StringToTag(const char *string)
 {
     Uint8 bytes[4] = { 0, 0, 0, 0 };
diff --git a/src/SDL_ttf.sym b/src/SDL_ttf.sym
index 50793b0b835f7fc8e2b56dfc93f18704575aad25..ce72ec5651235fadc1cda3c63a96064deed18855 100644
--- a/src/SDL_ttf.sym
+++ b/src/SDL_ttf.sym
@@ -119,5 +119,6 @@ SDL3_ttf_0.0.0 {
     TTF_WasInit;
     XDL_SetFontCharSpacing;
     XDL_SetFontFeatures;
+    XDL_SetFontVariations;
   local: *;
 };
