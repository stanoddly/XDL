 src/gpu/d3d12/SDL_gpu_d3d12.c            | 278 +++++++++++++++++++----
 src/render/direct3d12/SDL_render_d3d12.c | 118 ++++++++--
 src/video/windows/SDL_windowsvideo.c     |  15 ++
 src/video/windows/SDL_windowsvideo.h     |   8 +
