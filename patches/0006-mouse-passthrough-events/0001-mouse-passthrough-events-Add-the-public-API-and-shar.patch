+/**
+ * # XDL
+ *
+ * The API that XDL adds to SDL. None of this exists in stock SDL.
+ */
+
+#ifndef XDL_h_
+#define XDL_h_
+
+#include <SDL3/SDL_stdinc.h>
+#include <SDL3/SDL_video.h>
+
+#include <SDL3/SDL_begin_code.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Set whether a window receives the mouse input that passes through it.
+ *
+ * A window can let mouse input through to the windows beneath it, for example
+ * with a fully transparent shape set by SDL_SetWindowShape(). While this is
+ * enabled, mouse input over the window's area that goes to another window is
+ * also reported to this window as SDL_EVENT_MOUSE_MOTION,
+ * SDL_EVENT_MOUSE_BUTTON_DOWN and SDL_EVENT_MOUSE_BUTTON_UP, in window
+ * coordinates. The input still reaches the window beneath.
+ *
+ * Input the window receives itself is reported once, as usual. Only the
+ * left, middle, right, X1 and X2 buttons are reported; the wheel, and mouse
+ * input generated by touch or a pen, are not.
+ *
+ * When the pointer leaves the window's area, the window gets a motion event
+ * at its edge and SDL_EVENT_WINDOW_MOUSE_LEAVE. A press outside the window's
+ * area is not reported. The release of a reported press is always reported;
+ * if the pointer is outside the window's area, its window ID is that of the
+ * current mouse focus, usually 0.
+ *
+ * A press reported this way never captures the mouse, so the window beneath
+ * keeps receiving the drag. Hidden and minimized windows, and a window that
+ * captures the mouse, receive nothing this way.
+ *
+ * This is supported on Windows, macOS, and X11 with XInput 2.1 or later. It
+ * is not supported on Wayland, and under Xwayland it receives no input
+ * outside X11 windows.
+ *
+ * \param window the window.
+ * \param enabled true to receive the mouse input that passes through the
+ *                window, false to stop.
+ * \returns true on success or false on failure; call SDL_GetError() for more
+ *          information.
+ *
+ * \threadsafety This function should only be called on the main thread.
+ *
+ * \since This function is available since XDL 3.4.20-1.
+ *
+ * \sa SDL_SetWindowShape
+ */
+extern SDL_DECLSPEC bool SDLCALL XDL_SetWindowMousePassthroughEvents(SDL_Window *window, bool enabled);
+
+#ifdef __cplusplus
+}
+#endif
+#include <SDL3/SDL_close_code.h>
+
+#endif /* XDL_h_ */
