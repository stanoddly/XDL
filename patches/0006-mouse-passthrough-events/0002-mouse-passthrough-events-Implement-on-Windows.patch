index 0000000000000000000000000000000000000000..10e589f13e95dd79bdc01cdf3b20d2cce44df813
--- /dev/null
+++ b/src/video/windows/SDL_windowsmousepassthrough.c
@@ -0,0 +1,434 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
