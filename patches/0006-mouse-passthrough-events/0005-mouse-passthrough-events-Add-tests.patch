diff --git a/test/testmousepassthrough.c b/test/testmousepassthrough.c
new file mode 100644
index 0000000000000000000000000000000000000000..ccf9d6ef6f4c4937db58d12dff1859e3d3c39b8c
--- /dev/null
+++ b/test/testmousepassthrough.c
@@ -0,0 +1,239 @@
+/*
