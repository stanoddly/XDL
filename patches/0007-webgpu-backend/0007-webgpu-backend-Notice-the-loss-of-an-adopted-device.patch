From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: botoddly <250804054+botoddly@users.noreply.github.com>
Date: Mon, 9 Nov 2026 14:43:21 +0100
Subject: [PATCH] webgpu-backend: Notice the loss of an adopted device

---
 src/gpu/webgpu/SDL_gpu_webgpu.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/src/gpu/webgpu/SDL_gpu_webgpu.c b/src/gpu/webgpu/SDL_gpu_webgpu.c
index 6aa478b4d4318a5d22a3a22d823fb6039772e8c8..e4f30f3d18c1180d53ca9ec5e4688ff0f50920dd 100644
--- a/src/gpu/webgpu/SDL_gpu_webgpu.c
+++ b/src/gpu/webgpu/SDL_gpu_webgpu.c
@@ -1503,6 +1503,31 @@ static void WEBGPU_INTERNAL_DeviceLostCallback(WGPUDevice const *device, WGPUDev
     }
 }
 
+// WebGPU takes a device-lost callback only when it creates a device, and emdawnwebgpu cannot get the lost future of a device
+// imported from JavaScript. So for an adopted device the backend watches the JavaScript device's lost promise itself.
+// The watch is keyed by the renderer's flag and dropped when the renderer is destroyed, so a later loss cannot write to freed memory,
+// even when a new renderer reuses the address.
+EM_JS(void, WEBGPU_INTERNAL_WatchAdoptedDeviceLoss, (WGPUDevice device, SDL_AtomicInt *deviceLost), {
+    if (!WebGPU.xdlDeviceLossWatches) {
+        WebGPU.xdlDeviceLossWatches = new Map();
+    }
+    var watches = WebGPU.xdlDeviceLossWatches;
+    var watch = {};
+    watches.set(deviceLost, watch);
+    WebGPU.getJsObject(device).lost.then(() => {
+        if (watches.get(deviceLost) === watch) {
+            watches.delete(deviceLost);
+            Atomics.store(HEAP32, deviceLost >>> 2, 1);
+        }
+    });
+});
+
+EM_JS(void, WEBGPU_INTERNAL_UnwatchAdoptedDeviceLoss, (SDL_AtomicInt *deviceLost), {
+    if (WebGPU.xdlDeviceLossWatches) {
+        WebGPU.xdlDeviceLossWatches.delete(deviceLost);
+    }
+});
+
 static void WEBGPU_INTERNAL_RequestAdapterCallback(WGPURequestAdapterStatus status, WGPUAdapter adapter, WGPUStringView message, void *renderer, void *success)
 {
     if (status == WGPURequestAdapterStatus_Success) {
@@ -5924,6 +5949,7 @@ static void WEBGPU_INTERNAL_ReleaseWebGPUObjects(WebGPURenderer *renderer)
         wgpuQueueRelease(renderer->queue);
     }
     if (renderer->device != NULL) {
+        WEBGPU_INTERNAL_UnwatchAdoptedDeviceLoss(&renderer->deviceLost);
         // For an adopted device this only drops the reference SDL took when adopting it.
         // For an SDL-created device it drops the last reference, which destroys the device and fires its device-lost callback
         // right here, so neither callback can reach the renderer after it is freed.
@@ -6669,6 +6695,7 @@ static SDL_GPUDevice *WEBGPU_CreateDevice(bool debugMode, bool preferLowPower, S
         }
         wgpuDeviceAddRef(externalDevice);
         renderer->device = externalDevice;
+        WEBGPU_INTERNAL_WatchAdoptedDeviceLoss(renderer->device, &renderer->deviceLost);
     } else {
         WEBGPU_INTERNAL_RequestDevice(renderer, &getDeviceSucceeded);
     }
