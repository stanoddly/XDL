From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: botoddly <250804054+botoddly@users.noreply.github.com>
Date: Fri, 6 Nov 2026 21:35:36 +0100
Subject: [PATCH] vulkan-defer-defrag: Defer defrag while another command
 buffer is open

---
 src/gpu/vulkan/SDL_gpu_vulkan.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/src/gpu/vulkan/SDL_gpu_vulkan.c b/src/gpu/vulkan/SDL_gpu_vulkan.c
index a7d8d57d7d3c3a7f6bcfa47ffc51d436b65e30ac..f3515da19321fd16fdea0f7b3793768116fa1c0e 100644
--- a/src/gpu/vulkan/SDL_gpu_vulkan.c
+++ b/src/gpu/vulkan/SDL_gpu_vulkan.c
@@ -1219,6 +1219,8 @@ struct VulkanRenderer
     SDL_Mutex *windowLock;
 
     Uint8 defragInProgress;
+    // Acquired command buffers that are not submitted or cancelled yet, guarded by acquireCommandBufferLock.
+    Uint32 openCommandBufferCount;
 
     VulkanMemoryAllocation **allocationsToDefrag;
     Uint32 allocationsToDefragCount;
@@ -9656,6 +9658,8 @@ static SDL_GPUCommandBuffer *VULKAN_AcquireCommandBuffer(
     DescriptorSetCache *descriptorSetCache =
         VULKAN_INTERNAL_AcquireDescriptorSetCache(renderer);
 
+    renderer->openCommandBufferCount += 1;
+
     SDL_UnlockMutex(renderer->acquireCommandBufferLock);
 
     commandBuffer->descriptorSetCache = descriptorSetCache;
@@ -10814,7 +10818,15 @@ static bool VULKAN_Submit(
             swapchainTextureSubresource);
     }
 
+    /* Defrag leaves each moved texture's old image in a copy layout and moves
+     * its bindings, so another open command buffer may still sample that image.
+     * The lock stays held so that no command buffer is acquired until the
+     * containers point at the new resources.
+     */
+    SDL_LockMutex(renderer->acquireCommandBufferLock);
+
     if (performCleanups &&
+        renderer->openCommandBufferCount == 1 &&
         renderer->allocationsToDefragCount > 0 &&
         !renderer->defragInProgress) {
         if (!VULKAN_INTERNAL_DefragmentMemory(renderer, vulkanCommandBuffer))
@@ -10823,6 +10835,10 @@ static bool VULKAN_Submit(
         }
     }
 
+    renderer->openCommandBufferCount -= 1;
+
+    SDL_UnlockMutex(renderer->acquireCommandBufferLock);
+
     if (!VULKAN_INTERNAL_EndCommandBuffer(renderer, vulkanCommandBuffer)) {
         SDL_UnlockMutex(renderer->submitLock);
         return false;
@@ -10965,6 +10981,10 @@ static bool VULKAN_Cancel(
     vulkanCommandBuffer = (VulkanCommandBuffer *)commandBuffer;
     renderer = vulkanCommandBuffer->renderer;
 
+    SDL_LockMutex(renderer->acquireCommandBufferLock);
+    renderer->openCommandBufferCount -= 1;
+    SDL_UnlockMutex(renderer->acquireCommandBufferLock);
+
     result = renderer->vkResetCommandBuffer(
         vulkanCommandBuffer->commandBuffer,
         VK_COMMAND_BUFFER_RESET_RELEASE_RESOURCES_BIT);
