From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: botoddly <250804054+botoddly@users.noreply.github.com>
Date: Mon, 9 Nov 2026 14:37:14 +0100
Subject: [PATCH] locale-empty-items: Skip empty items in a preferred locale
 list

---
 src/locale/SDL_locale.c | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/src/locale/SDL_locale.c b/src/locale/SDL_locale.c
index 0cdd10130bc9c74c657ed1323122d8d9324abd39..6462fabba3100a803a2445ee499e3c7872e87074 100644
--- a/src/locale/SDL_locale.c
+++ b/src/locale/SDL_locale.c
@@ -61,15 +61,16 @@ static SDL_Locale **build_locales_from_csv_string(char *csv, int *count)
     SDL_memcpy(ptr, csv, slen);
 
     i = 0;
-    result[i++] = loc;
     while (true) { // parse out the string
-        while (SDL_isspace(*ptr)) {
-            ptr++; // skip whitespace.
+        // skip whitespace and empty items.
+        while (SDL_isspace(*ptr) || *ptr == ',') {
+            ptr++;
         }
 
         if (*ptr == '\0') {
             break;
         }
+        result[i++] = loc;
         loc->language = ptr++;
         while (true) {
             const char ch = *ptr;
@@ -81,7 +82,6 @@ static SDL_Locale **build_locales_from_csv_string(char *csv, int *count)
             } else if (ch == ',') {
                 *(ptr++) = '\0';
                 loc++;
-                result[i++] = loc;
                 break;
             } else if (ch == '\0') {
                 break;
@@ -91,8 +91,14 @@ static SDL_Locale **build_locales_from_csv_string(char *csv, int *count)
         }
     }
 
+    // nothing to report
+    if (i == 0) {
+        SDL_free(result);
+        return NULL;
+    }
+
     if (count) {
-        *count = num_locales;
+        *count = i;
     }
 
     return result;
