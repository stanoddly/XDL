+/**
+ * Locale test suite
+ */
+
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_test.h>
+#include "testautomation_suites.h"
+
+/* ================= Test Case Implementation ================== */
+
+typedef struct
+{
+    const char *language;
+    const char *country;
+} ExpectedLocale;
+
+static void checkPreferredLocales(const char *hint, const ExpectedLocale *expected, int expected_count)
+{
+    SDL_Locale **locales;
+    int count = -1;
+    int i;
+
+    SDL_SetHint(SDL_HINT_PREFERRED_LOCALES, hint);
+    locales = SDL_GetPreferredLocales(&count);
+    SDLTest_AssertPass("Call to SDL_GetPreferredLocales() with \"%s\"", hint);
+    SDLTest_AssertCheck(count == expected_count, "Check count for \"%s\", expected: %d, got: %d", hint, expected_count, count);
+
+    if (expected_count == 0) {
+        SDLTest_AssertCheck(locales == NULL, "Check result for \"%s\" is NULL", hint);
+    } else {
+        SDLTest_AssertCheck(locales != NULL, "Check result for \"%s\" is not NULL", hint);
+    }
+
+    if (locales && count == expected_count) {
+        for (i = 0; i < count; i++) {
+            const SDL_Locale *locale = locales[i];
+            SDLTest_AssertCheck(locale != NULL, "Check entry %d for \"%s\" is not NULL", i, hint);
+            if (!locale) {
+                continue;
+            }
+            SDLTest_AssertCheck(locale->language && SDL_strcmp(locale->language, expected[i].language) == 0,
+                                "Check language of entry %d for \"%s\", expected: \"%s\", got: \"%s\"", i, hint, expected[i].language, locale->language ? locale->language : "(null)");
+            if (expected[i].country) {
+                SDLTest_AssertCheck(locale->country && SDL_strcmp(locale->country, expected[i].country) == 0,
+                                    "Check country of entry %d for \"%s\", expected: \"%s\", got: \"%s\"", i, hint, expected[i].country, locale->country ? locale->country : "(null)");
+            } else {
+                SDLTest_AssertCheck(locale->country == NULL, "Check country of entry %d for \"%s\" is NULL", i, hint);
+            }
+        }
+        SDLTest_AssertCheck(locales[count] == NULL, "Check list for \"%s\" ends with NULL", hint);
+    }
+
+    SDL_free(locales);
+    SDL_ResetHint(SDL_HINT_PREFERRED_LOCALES);
+}
+
+/**
+ * Call to SDL_GetPreferredLocales with a list from SDL_HINT_PREFERRED_LOCALES
+ */
+static int SDLCALL locale_testPreferredLocalesHint(void *arg)
+{
+    const ExpectedLocale en_us_fr[] = { { "en", "US" }, { "fr", NULL } };
+    const ExpectedLocale en[] = { { "en", NULL } };
+    const ExpectedLocale en_fr[] = { { "en", NULL }, { "fr", NULL } };
+
+    checkPreferredLocales("en_US, fr", en_us_fr, 2);
+    checkPreferredLocales("en,", en, 1);
+    checkPreferredLocales(",en", en, 1);
+    checkPreferredLocales("en,,fr", en_fr, 2);
+    checkPreferredLocales(" , ", NULL, 0);
+    checkPreferredLocales("", NULL, 0);
+
+    return TEST_COMPLETED;
+}
+
+/* ================= Test References ================== */
+
+static const SDLTest_TestCaseReference localeTest1 = {
+    locale_testPreferredLocalesHint, "locale_testPreferredLocalesHint", "Call to SDL_GetPreferredLocales with SDL_HINT_PREFERRED_LOCALES", TEST_ENABLED
+};
+
+/* Sequence of Locale test cases */
+static const SDLTest_TestCaseReference *localeTests[] = {
+    &localeTest1,
+    NULL
+};
+
+/* Locale test suite (global) */
+SDLTest_TestSuiteReference localeTestSuite = {
+    "Locale",
+    NULL,
+    localeTests,
+    NULL
+};
