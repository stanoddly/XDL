From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: botoddly <250804054+botoddly@users.noreply.github.com>
Date: Mon, 9 Nov 2026 14:49:57 +0100
Subject: [PATCH] gpu-storage-buffer-usage: Keep a buffer's usage in a header
 that the front end can read

---
 src/gpu/SDL_sysgpu.h            |  5 +++++
 src/gpu/d3d12/SDL_gpu_d3d12.c   | 20 ++++++++++----------
 src/gpu/metal/SDL_gpu_metal.m   |  8 +++++++-
 src/gpu/vulkan/SDL_gpu_vulkan.c |  3 +++
 src/gpu/webgpu/SDL_gpu_webgpu.c |  7 ++++---
 5 files changed, 29 insertions(+), 14 deletions(-)

diff --git a/src/gpu/SDL_sysgpu.h b/src/gpu/SDL_sysgpu.h
index 6c956263b54ca5dee83bcda0c02f19a7f1ee21e3..3957aeb8c11610dfb4799c24110844108b657243 100644
--- a/src/gpu/SDL_sysgpu.h
+++ b/src/gpu/SDL_sysgpu.h
@@ -99,6 +99,11 @@ typedef struct TextureCommonHeader
     SDL_GPUTextureCreateInfo info;
 } TextureCommonHeader;
 
+typedef struct BufferCommonHeader
+{
+    SDL_GPUBufferUsageFlags usage;
+} BufferCommonHeader;
+
 typedef struct GraphicsPipelineCommonHeader
 {
     Uint32 num_vertex_samplers;
diff --git a/src/gpu/d3d12/SDL_gpu_d3d12.c b/src/gpu/d3d12/SDL_gpu_d3d12.c
index c53afbe5d2080b1fb107417f7b4974928249ba5e..1a3a0c28fefe19f760cdc6fb97b98752b8e23483 100644
--- a/src/gpu/d3d12/SDL_gpu_d3d12.c
+++ b/src/gpu/d3d12/SDL_gpu_d3d12.c
@@ -1211,7 +1211,7 @@ struct D3D12Buffer
 
 struct D3D12BufferContainer
 {
-    SDL_GPUBufferUsageFlags usage;
+    BufferCommonHeader header;
     Uint32 size;
     D3D12BufferType type;
 
@@ -1976,24 +1976,24 @@ static D3D12_RESOURCE_STATES D3D12_INTERNAL_DefaultBufferResourceState(
 {
     D3D12_RESOURCE_STATES states = D3D12_RESOURCE_STATE_COMMON;
 
-    if (buffer->container->usage & SDL_GPU_BUFFERUSAGE_VERTEX) {
+    if (buffer->container->header.usage & SDL_GPU_BUFFERUSAGE_VERTEX) {
         states |= D3D12_RESOURCE_STATE_VERTEX_AND_CONSTANT_BUFFER;
     }
-    if (buffer->container->usage & SDL_GPU_BUFFERUSAGE_INDEX) {
+    if (buffer->container->header.usage & SDL_GPU_BUFFERUSAGE_INDEX) {
         states |= D3D12_RESOURCE_STATE_INDEX_BUFFER;
     }
-    if (buffer->container->usage & SDL_GPU_BUFFERUSAGE_INDIRECT) {
+    if (buffer->container->header.usage & SDL_GPU_BUFFERUSAGE_INDIRECT) {
         states |= D3D12_RESOURCE_STATE_INDIRECT_ARGUMENT;
     }
-    if (buffer->container->usage & SDL_GPU_BUFFERUSAGE_GRAPHICS_STORAGE_READ) {
+    if (buffer->container->header.usage & SDL_GPU_BUFFERUSAGE_GRAPHICS_STORAGE_READ) {
         states |= D3D12_RESOURCE_STATE_ALL_SHADER_RESOURCE;
     }
-    if (buffer->container->usage & SDL_GPU_BUFFERUSAGE_COMPUTE_STORAGE_READ) {
+    if (buffer->container->header.usage & SDL_GPU_BUFFERUSAGE_COMPUTE_STORAGE_READ) {
         states |= D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
     }
 
     // If no read flags are set, read-write can be the default.
-    if (!states && buffer->container->usage & SDL_GPU_BUFFERUSAGE_COMPUTE_STORAGE_WRITE) {
+    if (!states && buffer->container->header.usage & SDL_GPU_BUFFERUSAGE_COMPUTE_STORAGE_WRITE) {
         return D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
     }
 
@@ -2017,7 +2017,7 @@ static void D3D12_INTERNAL_BufferBarrier(
         destinationState,
         buffer->handle,
         0,
-        buffer->container->usage & SDL_GPU_BUFFERUSAGE_COMPUTE_STORAGE_WRITE);
+        buffer->container->header.usage & SDL_GPU_BUFFERUSAGE_COMPUTE_STORAGE_WRITE);
 
     buffer->transitioned = true;
 }
@@ -4002,7 +4002,7 @@ static D3D12BufferContainer *D3D12_INTERNAL_CreateBufferContainer(
         return NULL;
     }
 
-    container->usage = usageFlags;
+    container->header.usage = usageFlags;
     container->size = size;
     container->type = type;
 
@@ -4357,7 +4357,7 @@ static void D3D12_INTERNAL_CycleActiveBuffer(
     // No buffer handle is available, create a new one.
     D3D12Buffer *buffer = D3D12_INTERNAL_CreateBuffer(
         renderer,
-        container->usage,
+        container->header.usage,
         container->size,
         container->type,
         container->debugName);
diff --git a/src/gpu/metal/SDL_gpu_metal.m b/src/gpu/metal/SDL_gpu_metal.m
index c3871964a56b4f97d4daae00a1234adc9a1c05f3..eaf292243ab976ebe6572a7883eec39cfc0af122 100644
--- a/src/gpu/metal/SDL_gpu_metal.m
+++ b/src/gpu/metal/SDL_gpu_metal.m
@@ -509,6 +509,8 @@ typedef struct MetalBuffer
 
 typedef struct MetalBufferContainer
 {
+    BufferCommonHeader header;
+
     MetalBuffer *activeBuffer;
     Uint32 size;
 
@@ -1659,12 +1661,16 @@ static SDL_GPUBuffer *METAL_CreateBuffer(
     const char *debugName)
 {
     @autoreleasepool {
-        return (SDL_GPUBuffer *)METAL_INTERNAL_CreateBufferContainer(
+        MetalBufferContainer *container = METAL_INTERNAL_CreateBufferContainer(
             (MetalRenderer *)driverData,
             size,
             true,
             false,
             debugName);
+        if (container) {
+            container->header.usage = usage;
+        }
+        return (SDL_GPUBuffer *)container;
     }
 }
 
diff --git a/src/gpu/vulkan/SDL_gpu_vulkan.c b/src/gpu/vulkan/SDL_gpu_vulkan.c
index c358b6b1786d9b583343668a6f38f29929a0fee9..597ad76bace0e5359e6c3f7f2fc00fee7983ebcd 100644
--- a/src/gpu/vulkan/SDL_gpu_vulkan.c
+++ b/src/gpu/vulkan/SDL_gpu_vulkan.c
@@ -538,6 +538,8 @@ struct VulkanBuffer
 
 struct VulkanBufferContainer
 {
+    BufferCommonHeader header;
+
     VulkanBuffer *activeBuffer;
 
     VulkanBuffer **buffers;
@@ -4345,6 +4347,7 @@ static VulkanBufferContainer *VULKAN_INTERNAL_CreateBufferContainer(
 
     bufferContainer = SDL_calloc(1, sizeof(VulkanBufferContainer));
 
+    bufferContainer->header.usage = usageFlags;
     bufferContainer->activeBuffer = buffer;
     buffer->container = bufferContainer;
     buffer->containerIndex = 0;
diff --git a/src/gpu/webgpu/SDL_gpu_webgpu.c b/src/gpu/webgpu/SDL_gpu_webgpu.c
index e4f30f3d18c1180d53ca9ec5e4688ff0f50920dd..1f95de98f2290727939417ac4859812440e54fa7 100644
--- a/src/gpu/webgpu/SDL_gpu_webgpu.c
+++ b/src/gpu/webgpu/SDL_gpu_webgpu.c
@@ -1087,13 +1087,14 @@ struct WebGPUBuffer
 
 struct WebGPUBufferContainer
 {
+    BufferCommonHeader header;
+
     WebGPUBuffer *activeBuffer;
 
     WebGPUBuffer **buffers;
     Uint32 bufferCapacity;
     Uint32 bufferCount;
 
-    SDL_GPUBufferUsageFlags usageFlags;
     WebGPUBufferType bufferType;
     Uint32 size;
 
@@ -4413,7 +4414,7 @@ static WebGPUBufferContainer *WEBGPU_INTERNAL_CreateBufferContainer(
     bufferContainer->dedicated = dedicated;
     bufferContainer->debugName = NULL;
     bufferContainer->bufferType = bufferType;
-    bufferContainer->usageFlags = usageFlags;
+    bufferContainer->header.usage = usageFlags;
     bufferContainer->size = size;
 
     if (bufferType == WEBGPU_BUFFER_TYPE_TRANSFER_UPLOAD) {
@@ -4534,7 +4535,7 @@ static void WEBGPU_INTERNAL_CycleBufferContainer(WebGPURenderer *renderer, WebGP
     }
 
     WebGPUBuffer *newBuf =
-        WEBGPU_INTERNAL_CreateBuffer(renderer, container->size, container->usageFlags, container->bufferType, NULL);
+        WEBGPU_INTERNAL_CreateBuffer(renderer, container->size, container->header.usage, container->bufferType, NULL);
 
     WEBGPU_INTERNAL_InsertElementIntoArray(container->buffers, container->bufferCapacity, container->bufferCount, WebGPUBuffer *, newBuf);
     container->activeBuffer = newBuf;
