From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: botoddly <250804054+botoddly@users.noreply.github.com>
Date: Mon, 9 Nov 2026 17:40:52 +0100
Subject: [PATCH] gpu-acquired-fence-reference: Give the caller of
 D3D12_SubmitAndAcquireFence its own fence reference

---
 src/gpu/d3d12/SDL_gpu_d3d12.c | 27 +++++++++++++--------------
 1 file changed, 13 insertions(+), 14 deletions(-)

diff --git a/src/gpu/d3d12/SDL_gpu_d3d12.c b/src/gpu/d3d12/SDL_gpu_d3d12.c
index cb1617a4fb5829670750cf36eefc178f1242965b..61e1b2397baf45396f192e493354209157fae216 100644
--- a/src/gpu/d3d12/SDL_gpu_d3d12.c
+++ b/src/gpu/d3d12/SDL_gpu_d3d12.c
@@ -1008,7 +1008,6 @@ struct D3D12CommandBuffer
     ID3D12CommandAllocator *commandAllocator;
     ID3D12GraphicsCommandList *graphicsCommandList;
     D3D12Fence *inFlightFence;
-    bool autoReleaseFence;
 
     // Presentation data
     D3D12PresentData *presentDatas;
@@ -7759,8 +7758,6 @@ static SDL_GPUCommandBuffer *D3D12_AcquireCommandBuffer(
     SDL_zeroa(commandBuffer->computeReadWriteStorageBuffers);
     SDL_zeroa(commandBuffer->computeUniformBuffers);
 
-    commandBuffer->autoReleaseFence = true;
-
     return (SDL_GPUCommandBuffer *)commandBuffer;
 }
 
@@ -8132,8 +8129,8 @@ static bool D3D12_INTERNAL_CleanCommandBuffer(
     // Reset presentation
     commandBuffer->presentDataCount = 0;
 
-    // The fence is now available (unless SubmitAndAcquireFence was called)
-    if (commandBuffer->autoReleaseFence) {
+    // Release the command buffer's reference to the fence. A canceled command buffer has none.
+    if (commandBuffer->inFlightFence) {
         D3D12_ReleaseFence(
             (SDL_GPURenderer *)renderer,
             (SDL_GPUFence *)commandBuffer->inFlightFence);
@@ -8252,12 +8249,6 @@ static bool D3D12_INTERNAL_Submit(
         return false;
     }
 
-    // Return the fence while submitLock is held, another thread could
-    // recycle this command buffer as soon as the lock is released.
-    if (fence) {
-        *fence = (SDL_GPUFence *)d3d12CommandBuffer->inFlightFence;
-    }
-
     // Mark that a fence should be signaled after command list execution
     res = ID3D12CommandQueue_Signal(
         renderer->commandQueue,
@@ -8268,6 +8259,13 @@ static bool D3D12_INTERNAL_Submit(
         CHECK_D3D12_ERROR_AND_RETURN("Failed to enqueue fence signal!", false);
     }
 
+    // Give the caller its own reference while submitLock is held, another
+    // thread could clean this command buffer as soon as the lock is released.
+    if (fence) {
+        (void)SDL_AtomicIncRef(&d3d12CommandBuffer->inFlightFence->referenceCount);
+        *fence = (SDL_GPUFence *)d3d12CommandBuffer->inFlightFence;
+    }
+
     // Mark the command buffer as submitted
     if (renderer->submittedCommandBufferCount + 1 >= renderer->submittedCommandBufferCapacity) {
         renderer->submittedCommandBufferCapacity = renderer->submittedCommandBufferCount + 1;
@@ -8366,10 +8364,12 @@ static bool D3D12_Submit(
 static SDL_GPUFence *D3D12_SubmitAndAcquireFence(
     SDL_GPUCommandBuffer *commandBuffer)
 {
-    D3D12CommandBuffer *d3d12CommandBuffer = (D3D12CommandBuffer *)commandBuffer;
     SDL_GPUFence *fence = NULL;
-    d3d12CommandBuffer->autoReleaseFence = false;
     if (!D3D12_INTERNAL_Submit(commandBuffer, &fence)) {
+        // Presenting or cleaning can fail after the caller got its reference
+        if (fence) {
+            D3D12_ReleaseFence((SDL_GPURenderer *)((D3D12CommandBuffer *)commandBuffer)->renderer, fence);
+        }
         return NULL;
     }
     return fence;
@@ -8390,7 +8390,6 @@ static bool D3D12_Cancel(
 #endif
     CHECK_D3D12_ERROR_AND_RETURN("Failed to close command list!", false);
 
-    d3d12CommandBuffer->autoReleaseFence = false;
     SDL_LockMutex(renderer->submitLock);
     result = D3D12_INTERNAL_CleanCommandBuffer(renderer, d3d12CommandBuffer, true);
     SDL_UnlockMutex(renderer->submitLock);
