     }
@@ -6235,6 +6262,54 @@ bool XDL_SetWindowMousePassthroughEvents(SDL_Window *window, bool enabled)
     return true;
 }
 
+bool XDL_SetWindowInputRegion(SDL_Window *window, const SDL_Rect *rects, int count)
+{
+    SDL_PropertiesID props;
+
+    CHECK_WINDOW_MAGIC(window, false);
+
+    if (!(window->flags & SDL_WINDOW_TRANSPARENT)) {
+        return SDL_SetError("Window must be created with SDL_WINDOW_TRANSPARENT");
+    }
+    if (window->mouse_passthrough_events) {
+        return SDL_SetError("Window has mouse passthrough events enabled");
+    }
+    if (count < 0) {
+        return SDL_InvalidParamError("count");
+    }
+    if (count > 0 && !rects) {
+        return SDL_InvalidParamError("rects");
+    }
+    if (!_this->SetWindowInputRegion) {
+        return SDL_Unsupported();
+    }
+
+    props = SDL_GetWindowProperties(window);
+    if (!props) {
+        return false;
+    }
+
+    if (count > window->input_region_count) {
+        SDL_Rect *grown = (SDL_Rect *)SDL_realloc(window->input_region_rects, count * sizeof(*grown));
+        if (!grown) {
+            return false;
+        }
+        window->input_region_rects = grown;
+    }
+    if (count > 0) {
+        SDL_memcpy(window->input_region_rects, rects, count * sizeof(*rects));
+    }
+    window->input_region_count = count;
+
+    if (!_this->SetWindowInputRegion(_this, window, window->input_region_rects, count)) {
+        return false;
+    }
+    window->has_input_region = true;
+
+    // The region replaces any shape, which SDL would otherwise apply again when the window is resized.
+    return SDL_ClearProperty(props, SDL_PROP_WINDOW_SHAPE_POINTER);
+}
