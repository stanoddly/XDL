+++ b/include/XDL/XDL.h
@@ -64,6 +64,9 @@ extern "C" {
  * If windows with this enabled overlap, only one of them receives the input,
  * and which one does not depend on their stacking order.
  *
+ * Enabling fails for a window that has an input region, see
+ * XDL_SetWindowInputRegion().
+ *
  * This is supported on Windows, macOS, and X11 with XInput 2.1 or later. It
  * is not supported on Wayland, and under Xwayland it receives no input
  * outside X11 windows.
@@ -82,6 +85,62 @@ extern "C" {
  */
 extern SDL_DECLSPEC bool SDLCALL XDL_SetWindowMousePassthroughEvents(SDL_Window *window, bool enabled);
 
+/**
+ * Set the parts of a transparent window that take mouse input.
+ *
+ * A click inside one of the rectangles reaches the window as its own mouse
+ * events and not the windows beneath it. Everywhere else, mouse input passes
+ * through to the windows beneath. A count of 0 lets all mouse input through.
+ *
+ * The rectangles are in window coordinates, as mouse events report them, and
+ * rectangles with no area are ignored. They are copied, so the array can be
+ * freed afterwards. Each call replaces the previous region and any shape set
+ * by SDL_SetWindowShape(). Unlike a shape, the region doesn't change what the
+ * window shows, and it is meant to be updated as often as every frame.
+ *
+ * The window must have been created with the SDL_WINDOW_TRANSPARENT flag. A
+ * window can't have both an input region and mouse passthrough events: once
+ * it has a region, even an empty one, XDL_SetWindowMousePassthroughEvents()
+ * fails for it, and this fails while those events are enabled.
+ *
+ * Each platform takes the input in the region in its own way:
+ *
+ * - Wayland: the region is the surface's input region. It takes effect when
+ *   the window next presents a frame. The window takes all mouse input in
+ *   the region.
+ * - X11: the region is the window's input shape, which needs the X server's
+ *   SHAPE extension. The window takes all mouse input in the region.
+ * - Windows: the window lets all mouse input through, and a low-level mouse
+ *   hook keeps a left button press in the region, and its release, from the
+ *   windows beneath and reports both to the window. A press still reaches a
+ *   window above this one. Motion, the wheel and the other buttons always
+ *   reach the windows beneath, and the window doesn't take the keyboard
+ *   focus. If the hook can't be installed, this fails and the window still
+ *   lets all mouse input through.
+ * - macOS: Cocoa has no input region, so on each call the window takes all
+ *   mouse input if the cursor is inside the region, and none otherwise. The
+ *   window also updates this from the mouse motion it receives. A change of
+ *   the region under a cursor standing still takes effect on the next call,
+ *   so until then a click there may still reach the windows beneath, or be
+ *   taken outside the region.
+ *
+ * \param window the window.
+ * \param rects an array of rectangles in window coordinates, or NULL if
+ *              count is 0.
+ * \param count the number of rectangles, 0 to let all mouse input through.
+ * \returns true on success or false on failure, for example on a platform
+ *          that doesn't support it; call SDL_GetError() for more
+ *          information.
+ *
+ * \threadsafety This function should only be called on the main thread.
+ *
+ * \since This function is available since XDL 3.4.20-9.
+ *
+ * \sa SDL_SetWindowShape
+ * \sa XDL_SetWindowMousePassthroughEvents
+ */
+extern SDL_DECLSPEC bool SDLCALL XDL_SetWindowInputRegion(SDL_Window *window, const SDL_Rect *rects, int count);
+
