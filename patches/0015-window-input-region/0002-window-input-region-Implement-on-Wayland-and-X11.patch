Date: Mon, 9 Nov 2026 22:01:24 +0100
Subject: [PATCH] window-input-region: Implement on Wayland and X11

---
 src/video/wayland/SDL_waylandshape.c  | 34 ++++++++++++++++++++
 src/video/wayland/SDL_waylandshape.h  |  1 +
 src/video/wayland/SDL_waylandvideo.c  |  1 +
 src/video/wayland/SDL_waylandwindow.c |  4 +++
 src/video/x11/SDL_x11shape.c          | 46 +++++++++++++++++++++++++++
 src/video/x11/SDL_x11shape.h          |  1 +
 src/video/x11/SDL_x11sym.h            |  2 ++
 src/video/x11/SDL_x11video.c          |  1 +
 8 files changed, 90 insertions(+)

diff --git a/src/video/wayland/SDL_waylandshape.c b/src/video/wayland/SDL_waylandshape.c
index c5cc01ee8c3ce70de69f1814fdf890ea66efbefe..eca5ded92bb12f9b707a87edddd2431ac29532fe 100644
--- a/src/video/wayland/SDL_waylandshape.c
+++ b/src/video/wayland/SDL_waylandshape.c
@@ -88,4 +88,38 @@ bool Wayland_UpdateWindowShape(SDL_VideoDevice *_this, SDL_Window *window, SDL_S
     return true;
 }
 
+bool Wayland_SetWindowInputRegion(SDL_VideoDevice *_this, SDL_Window *window, const SDL_Rect *rects, int count)
+{
+    SDL_VideoData *video = _this->internal;
+    SDL_WindowData *data = window->internal;
+    struct wl_region *region;
+    // The pointer scale is set when the window is first configured. SDL applies the region again when the window is resized.
+    const double scale_x = data->pointer_scale.x > 0.0 ? data->pointer_scale.x : 1.0;
+    const double scale_y = data->pointer_scale.y > 0.0 ? data->pointer_scale.y : 1.0;
+    int i;
+
+    if (!data->surface) {
+        return SDL_SetError("Window has no surface");
+    }
+
+    // An empty region lets all input through. The compositor applies the region with the surface's next commit, when the window presents a frame.
+    region = wl_compositor_create_region(video->compositor);
+    for (i = 0; i < count; ++i) {
+        const SDL_Rect *rect = &rects[i];
+        if (rect->w > 0 && rect->h > 0) {
+            /* A region is in surface coordinates, which differ from window coordinates when scaling to the display or emulating a fullscreen
+               mode. The pointer scale maps surface coordinates to the window coordinates mouse events have. Rounded outward, so a scaled
+               rectangle still covers every point of the original. */
+            const int x0 = (int)SDL_floor(rect->x / scale_x);
+            const int y0 = (int)SDL_floor(rect->y / scale_y);
+            const int x1 = (int)SDL_ceil((rect->x + rect->w) / scale_x);
+            const int y1 = (int)SDL_ceil((rect->y + rect->h) / scale_y);
+            wl_region_add(region, x0, y0, x1 - x0, y1 - y0);
+        }
+    }
+    wl_surface_set_input_region(data->surface, region);
+    wl_region_destroy(region);
+    return true;
+}
+
 #endif // SDL_VIDEO_DRIVER_WAYLAND
diff --git a/src/video/wayland/SDL_waylandshape.h b/src/video/wayland/SDL_waylandshape.h
index 27a83a88e7e22b152c995eaec6acecfedb5cff69..f27a2747f4509f142afbc1614c2f0f954c8f4b47 100644
