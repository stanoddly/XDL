+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+#if defined(SDL_VIDEO_DRIVER_WINDOWS) && !defined(SDL_PLATFORM_XBOXONE) && !defined(SDL_PLATFORM_XBOXSERIES)
+
+#include "SDL_windowsvideo.h"
+#include "SDL_windowsmousehook.h"
+#include "SDL_windowsmousepassthrough.h"
+
+/* A low-level mouse hook sees the mouse input that goes to every window. Windows holds each mouse event, for the whole system, until the hook
+   returns. So the hook runs on its own thread with its own message loop, and the features that need it share one. Each decides, as the input
+   happens, what to do with it, and queues what the event pump reports on the main thread. */
+
+static struct
+{
+    int num_users;
+    // The last user is releasing the hook. Waiting for the thread handles sent messages, which can run SDL and application code.
+    bool stopping;
+    SDL_Mutex *lock;
+    // The thread with the SDL windows, which reports the input. It is woken with a thread message, because a window can be recreated.
+    DWORD main_thread_id;
+    HANDLE thread;
+    HANDLE ready_event;
+    HANDLE stop_event;
+    HHOOK hook;
+    DWORD hook_error;
+    UINT wake_message;
+    // The hook reports physical coordinates, so its thread is per-monitor DPI aware for hit testing, whatever the process is.
+    DPI_AWARENESS_CONTEXT (WINAPI *SetThreadDpiAwarenessContext)(DPI_AWARENESS_CONTEXT);
+} mouse_hook;
+
+// The hook reports the requested position, which can lie past a screen edge or the cursor clip rectangle; the cursor itself stays inside both.
+static POINT ClampToCursorArea(POINT pt)
+{
+    HMONITOR monitor = MonitorFromPoint(pt, MONITOR_DEFAULTTONEAREST);
+    MONITORINFO info;
+    RECT clip;
+
+    SDL_zero(info);
+    info.cbSize = sizeof(info);
+    if (monitor && GetMonitorInfo(monitor, &info)) {
+        pt.x = SDL_clamp(pt.x, info.rcMonitor.left, info.rcMonitor.right - 1);
+        pt.y = SDL_clamp(pt.y, info.rcMonitor.top, info.rcMonitor.bottom - 1);
+    }
+    if (GetClipCursor(&clip)) {
+        pt.x = SDL_clamp(pt.x, clip.left, clip.right - 1);
+        pt.y = SDL_clamp(pt.y, clip.top, clip.bottom - 1);
+    }
+    return pt;
+}
+
+static LRESULT CALLBACK WIN_MouseHookProc(int nCode, WPARAM wParam, LPARAM lParam)
+{
+    if (nCode == HC_ACTION) {
+        const MSLLHOOKSTRUCT *info = (const MSLLHOOKSTRUCT *)lParam;
+
+        // Touch and pens generate mouse input too, and the hook leaves it alone.
+        if (WIN_GetMouseMessageSource((ULONG)info->dwExtraInfo) == SDL_MOUSE_EVENT_SOURCE_MOUSE) {
+            const POINT pt = ClampToCursorArea(info->pt);
+            WIN_HandleMousePassthroughHookInput((UINT)wParam, pt, HIWORD(info->mouseData));
+        }
+    }
+    return CallNextHookEx(NULL, nCode, wParam, lParam);
+}
+
+static DWORD WINAPI WIN_MouseHookThread(LPVOID param)
+{
+    HMODULE module;
+    MSG msg;
+
+    // Windows silently removes a low-level hook that does not return in time.
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    if (mouse_hook.SetThreadDpiAwarenessContext) {
+        mouse_hook.SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+    }
+
+    // SetWindowsHookEx() needs the module with the hook, and SDL can be linked statically or dynamically.
+    if (GetModuleHandleEx(GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT | GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (LPTSTR)WIN_MouseHookProc, &module)) {
+        mouse_hook.hook = SetWindowsHookEx(WH_MOUSE_LL, WIN_MouseHookProc, module, 0);
+    }
+    mouse_hook.hook_error = mouse_hook.hook ? 0 : GetLastError();
+    SetEvent(mouse_hook.ready_event);
+    if (!mouse_hook.hook) {
+        return 0;
+    }
+
+    // Windows calls the hook while this thread retrieves messages.
+    for (;;) {
+        const DWORD result = MsgWaitForMultipleObjects(1, &mouse_hook.stop_event, FALSE, INFINITE, QS_ALLINPUT);
+        if (result != WAIT_OBJECT_0 + 1) {
+            break;
+        }
+        while (PeekMessage(&msg, NULL, 0, 0, PM_REMOVE)) {
+        }
+    }
+
+    UnhookWindowsHookEx(mouse_hook.hook);
+    mouse_hook.hook = NULL;
+    return 0;
+}
+
+static void StopThread(void)
+{
+    if (mouse_hook.thread) {
+        HANDLE thread = mouse_hook.thread;
+        SetEvent(mouse_hook.stop_event);
+        // Handle messages sent to this thread while waiting, so a hook call that sent one can finish.
+        while (MsgWaitForMultipleObjects(1, &thread, FALSE, INFINITE, QS_SENDMESSAGE) == WAIT_OBJECT_0 + 1) {
+            MSG msg;
+            PeekMessage(&msg, NULL, 0, 0, PM_NOREMOVE | PM_QS_SENDMESSAGE);
+        }
+        CloseHandle(thread);
+        mouse_hook.thread = NULL;
+    }
+    if (mouse_hook.ready_event) {
+        CloseHandle(mouse_hook.ready_event);
+        mouse_hook.ready_event = NULL;
+    }
+    if (mouse_hook.stop_event) {
+        CloseHandle(mouse_hook.stop_event);
+        mouse_hook.stop_event = NULL;
+    }
+    mouse_hook.hook = NULL;
+}
+
+static bool StartThread(SDL_VideoDevice *_this)
+{
+    mouse_hook.SetThreadDpiAwarenessContext = _this->internal->SetThreadDpiAwarenessContext;
+    mouse_hook.ready_event = CreateEvent(NULL, FALSE, FALSE, NULL);
+    mouse_hook.stop_event = CreateEvent(NULL, TRUE, FALSE, NULL);
+    if (!mouse_hook.ready_event || !mouse_hook.stop_event) {
+        WIN_SetError("CreateEvent()");
+        StopThread();
+        return false;
+    }
+
+    mouse_hook.thread = CreateThread(NULL, 0, WIN_MouseHookThread, NULL, 0, NULL);
+    if (!mouse_hook.thread) {
+        WIN_SetError("CreateThread()");
+        StopThread();
+        return false;
+    }
+
+    WaitForSingleObject(mouse_hook.ready_event, INFINITE);
+    if (!mouse_hook.hook) {
+        // The thread exits on its own when the hook fails.
+        const DWORD error = mouse_hook.hook_error;
+        StopThread();
+        SetLastError(error);
+        return WIN_SetError("SetWindowsHookEx()");
+    }
+    return true;
+}
+
+// Frees everything once the hook has no user and the thread is stopped.
+static void Cleanup(void)
+{
+    SDL_DestroyMutex(mouse_hook.lock);
+    SDL_zero(mouse_hook);
+}
+
+bool WIN_AcquireMouseHook(SDL_VideoDevice *_this)
+{
+    // Only the last user runs code during the stop, and it doesn't come back.
+    if (mouse_hook.stopping) {
+        return SDL_SetError("The mouse hook is stopping");
+    }
+
+    if (mouse_hook.num_users == 0) {
+        mouse_hook.lock = SDL_CreateMutex();
+        if (!mouse_hook.lock) {
+            return false;
+        }
+        mouse_hook.wake_message = RegisterWindowMessage(TEXT("SDL_MouseHookWake"));
+        mouse_hook.main_thread_id = GetCurrentThreadId();
+        if (!StartThread(_this)) {
+            Cleanup();
+            return false;
+        }
+    }
+    ++mouse_hook.num_users;
+    return true;
+}
+
+void WIN_ReleaseMouseHook(void)
+{
+    if (--mouse_hook.num_users > 0) {
+        return;
+    }
+
+    // The hook takes the lock, so nothing here holds it while waiting for the thread.
+    mouse_hook.stopping = true;
+    StopThread();
+    Cleanup();
+}
+
+void WIN_LockMouseHook(void)
+{
+    SDL_LockMutex(mouse_hook.lock);
+}
+
+void WIN_UnlockMouseHook(void)
+{
+    SDL_UnlockMutex(mouse_hook.lock);
+}
+
+DWORD WIN_GetMouseHookMainThreadID(void)
+{
+    return mouse_hook.main_thread_id;
+}
+
+void WIN_WakeForMouseHookInput(void)
+{
+    // PostThreadMessage() does not wait.
+    PostThreadMessage(mouse_hook.main_thread_id, mouse_hook.wake_message, 0, 0);
+}
+
+#endif // defined(SDL_VIDEO_DRIVER_WINDOWS) && !defined(SDL_PLATFORM_XBOXONE) && !defined(SDL_PLATFORM_XBOXSERIES)
