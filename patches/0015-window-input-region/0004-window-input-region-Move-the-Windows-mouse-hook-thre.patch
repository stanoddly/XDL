diff --git a/src/video/windows/SDL_windowsmousehook.c b/src/video/windows/SDL_windowsmousehook.c
new file mode 100644
index 0000000000000000000000000000000000000000..91992dfc931d952e69f90af74aa4dd7579279020
--- /dev/null
+++ b/src/video/windows/SDL_windowsmousehook.c
@@ -0,0 +1,237 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
