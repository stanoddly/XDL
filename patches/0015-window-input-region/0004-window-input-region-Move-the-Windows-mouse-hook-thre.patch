+extern DWORD WIN_GetMouseHookMainThreadID(void);
+// Wakes the event loop, so SDL_WaitEvent() returns and the input the hook queued is reported.
+extern void WIN_WakeForMouseHookInput(void);
+
+#endif // SDL_windowsmousehook_h_
