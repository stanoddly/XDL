+#ifndef SDL_windowsmousehook_h_
+#define SDL_windowsmousehook_h_
+
+// Starts the low-level mouse hook for one more user. Fails if the hook can't be installed or is stopping.
+extern bool WIN_AcquireMouseHook(SDL_VideoDevice *_this);
+// Stops the hook after its last user. Waiting for the hook's thread handles messages sent to this thread, which can run SDL and application code.
+extern void WIN_ReleaseMouseHook(void);
+// Guards the state the hook's thread shares with the main thread. Only while the hook has a user.
+extern void WIN_LockMouseHook(void);
+extern void WIN_UnlockMouseHook(void);
