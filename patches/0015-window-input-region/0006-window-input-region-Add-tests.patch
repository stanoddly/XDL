+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely.
+*/
+
+/* An always-on-top transparent window that draws two squares and takes mouse input only inside them, with XDL_SetWindowInputRegion(). Mouse
+   input anywhere else reaches the windows beneath it. It logs each mouse event, and a square lights up while a button is held in it. It uses
+   the software renderer.
+
+   --move  slides the squares across the window, setting the region again every frame.
+   --fullscreen  covers the display instead, like a desktop overlay.
+   --seconds N  quits after N seconds. Otherwise quit with Ctrl+C, or with Escape while the window has keyboard focus. */
+
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_main.h>
+#include <XDL/XDL.h>
+
+#define NUM_SQUARES 2
+#define SQUARE_SIZE 120
+#define SPEED 120.0f
+
+static void LogEvent(const SDL_Event *event)
+{
+    switch (event->type) {
+    case SDL_EVENT_MOUSE_MOTION:
+        SDL_Log("motion window=%" SDL_PRIu32 " (%.1f, %.1f)", event->motion.windowID, event->motion.x, event->motion.y);
+        break;
+    case SDL_EVENT_MOUSE_BUTTON_DOWN:
+    case SDL_EVENT_MOUSE_BUTTON_UP:
+        SDL_Log("button %d %s window=%" SDL_PRIu32 " (%.1f, %.1f) clicks=%d", event->button.button, event->button.down ? "down" : "up",
+                event->button.windowID, event->button.x, event->button.y, event->button.clicks);
+        break;
+    case SDL_EVENT_MOUSE_WHEEL:
+        SDL_Log("wheel window=%" SDL_PRIu32 " (%.1f, %.1f)", event->wheel.windowID, event->wheel.x, event->wheel.y);
+        break;
+    case SDL_EVENT_WINDOW_MOUSE_ENTER:
+        SDL_Log("enter window=%" SDL_PRIu32, event->window.windowID);
+        break;
+    case SDL_EVENT_WINDOW_MOUSE_LEAVE:
+        SDL_Log("leave window=%" SDL_PRIu32, event->window.windowID);
+        break;
+    default:
+        break;
+    }
+}
+
+// The squares, spread across the window's middle row and shifted by offset, wrapping around.
+static void PlaceSquares(SDL_Window *window, float offset, SDL_Rect *squares)
+{
+    int w, h, i;
+
+    SDL_GetWindowSize(window, &w, &h);
+    for (i = 0; i < NUM_SQUARES; ++i) {
+        const int span = SDL_max(w - SQUARE_SIZE, 1);
+        squares[i].x = ((w * (i + 1)) / (NUM_SQUARES + 1) - SQUARE_SIZE / 2 + (int)offset) % span;
+        squares[i].y = (h - SQUARE_SIZE) / 2;
+        squares[i].w = SQUARE_SIZE;
+        squares[i].h = SQUARE_SIZE;
+    }
+}
+
+int main(int argc, char *argv[])
+{
+    SDL_Window *window;
+    SDL_Renderer *renderer;
+    SDL_WindowFlags flags = SDL_WINDOW_TRANSPARENT | SDL_WINDOW_BORDERLESS | SDL_WINDOW_ALWAYS_ON_TOP;
+    SDL_Rect squares[NUM_SQUARES];
+    bool move = false;
+    bool done = false;
+    bool held = false;
+    Uint64 deadline = 0;
+    Uint64 last = 0;
+    float offset = 0.0f;
+    int i;
+
+    for (i = 1; i < argc; ++i) {
+        if (SDL_strcmp(argv[i], "--move") == 0) {
+            move = true;
+        } else if (SDL_strcmp(argv[i], "--fullscreen") == 0) {
+            flags |= SDL_WINDOW_FULLSCREEN;
+        } else if (SDL_strcmp(argv[i], "--seconds") == 0 && i + 1 < argc) {
+            deadline = SDL_GetTicks() + (Uint64)SDL_atoi(argv[++i]) * 1000;
+        } else {
+            SDL_Log("Usage: %s [--move] [--fullscreen] [--seconds N]", argv[0]);
+            return 1;
+        }
+    }
+
+    if (!SDL_Init(SDL_INIT_VIDEO)) {
+        SDL_Log("SDL_Init failed: %s", SDL_GetError());
+        return 1;
+    }
+
+    window = SDL_CreateWindow("testinputregion", 640, 480, flags);
+    if (!window) {
+        SDL_Log("SDL_CreateWindow failed: %s", SDL_GetError());
+        SDL_Quit();
+        return 1;
+    }
+    renderer = SDL_CreateRenderer(window, SDL_SOFTWARE_RENDERER);
+    if (!renderer) {
+        SDL_Log("SDL_CreateRenderer failed: %s", SDL_GetError());
+        SDL_Quit();
+        return 1;
+    }
+    SDL_Log("Window %" SDL_PRIu32 " takes mouse input only inside its squares", SDL_GetWindowID(window));
+
+    while (!done) {
+        SDL_Event event;
+        Uint64 now = SDL_GetTicks();
+        // With --move, a frame about every 16 ms. Without, sleep until an event arrives or the deadline is due.
+        Sint32 timeout = move ? 16 : -1;
+
+        if (deadline) {
+            timeout = (Sint32)SDL_min(deadline - SDL_min(now, deadline), (Uint64)(move ? 16 : SDL_MAX_SINT32));
+        }
+        if (SDL_WaitEventTimeout(&event, timeout)) {
+            do {
+                LogEvent(&event);
+                if (event.type == SDL_EVENT_QUIT || (event.type == SDL_EVENT_KEY_DOWN && event.key.key == SDLK_ESCAPE)) {
+                    done = true;
+                } else if (event.type == SDL_EVENT_MOUSE_BUTTON_DOWN || event.type == SDL_EVENT_MOUSE_BUTTON_UP) {
+                    held = event.button.down;
+                }
+            } while (SDL_PollEvent(&event));
+        }
+        now = SDL_GetTicks();
+        if (deadline && now >= deadline) {
+            done = true;
+        }
+
+        if (move && last) {
+            offset += SPEED * (float)(now - last) / 1000.0f;
+        }
+        last = now;
+        PlaceSquares(window, offset, squares);
+        if (!XDL_SetWindowInputRegion(window, squares, NUM_SQUARES)) {
+            SDL_Log("XDL_SetWindowInputRegion failed: %s", SDL_GetError());
+            break;
+        }
+
+        // On Wayland the region takes effect with this present.
+        SDL_SetRenderDrawColor(renderer, 0, 0, 0, SDL_ALPHA_TRANSPARENT);
+        SDL_RenderClear(renderer);
+        for (i = 0; i < NUM_SQUARES; ++i) {
+            const SDL_FRect rect = { (float)squares[i].x, (float)squares[i].y, (float)squares[i].w, (float)squares[i].h };
+            if (held) {
+                SDL_SetRenderDrawColor(renderer, 255, 160, 0, SDL_ALPHA_OPAQUE);
+            } else {
+                SDL_SetRenderDrawColor(renderer, 64, 64, 160, SDL_ALPHA_OPAQUE);
+            }
+            SDL_RenderFillRect(renderer, &rect);
+        }
+        SDL_RenderPresent(renderer);
+    }
+
+    SDL_DestroyRenderer(renderer);
+    SDL_DestroyWindow(window);
+    SDL_Quit();
+    return 0;
+}
