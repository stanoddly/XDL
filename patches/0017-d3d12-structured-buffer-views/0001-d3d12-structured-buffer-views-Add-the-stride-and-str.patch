index 5a97bbd9f57a21a3105800a7862613d83aef702b..b73225c515b674da169c4f94be646dead16e1f2e 100644
--- a/src/gpu/vulkan/SDL_gpu_vulkan.c
+++ b/src/gpu/vulkan/SDL_gpu_vulkan.c
@@ -7000,6 +7000,7 @@ static SDL_GPUBuffer *VULKAN_CreateBuffer(
     SDL_GPURenderer *driverData,
