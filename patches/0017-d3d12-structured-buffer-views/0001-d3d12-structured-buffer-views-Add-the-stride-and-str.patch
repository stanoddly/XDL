index cc9300bb41f335428cb801e750ddde55f27b357a..e955e30530174250083825be1991f3da4ffdf6e5 100644
--- a/src/gpu/webgpu/SDL_gpu_webgpu.c
+++ b/src/gpu/webgpu/SDL_gpu_webgpu.c
@@ -4665,6 +4665,7 @@ static SDL_GPUBuffer *WEBGPU_CreateBuffer(
     SDL_GPURenderer *driverData,
     SDL_GPUBufferUsageFlags usageFlags,
