+/* The descriptor of a storage buffer slot: the buffer's structured view when the shader declares the slot structured, otherwise its raw view.
+ * Direct3D 12 takes a structured buffer's stride from its view, so a structured slot accessed through the raw view, whose stride is 0, accesses wrong elements on some drivers.
+ * A buffer without a structured view, created without a valid XDL_PROP_GPU_BUFFER_CREATE_STRIDE_NUMBER, keeps that behavior, and the device's first such access logs a warning.
+ * An unbound slot gets a zero handle, which D3D12_INTERNAL_WriteGPUDescriptors skips. */
+static D3D12_CPU_DESCRIPTOR_HANDLE D3D12_INTERNAL_GetStorageBufferDescriptor(
+    D3D12Renderer *renderer,
+    D3D12Buffer *buffer,
+    Uint32 structuredSlots,
+    Uint32 slot,
+    bool readWrite)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE none;
+    none.ptr = 0;
+    if (buffer == NULL) {
+        return none;
+    }
+
+    if (structuredSlots & (1u << slot)) {
+        D3D12StagingDescriptor *structured = readWrite ? &buffer->structuredUavDescriptor : &buffer->structuredSrvDescriptor;
+        if (structured->heap != NULL) {
+            return structured->cpuHandle;
+        }
+
+        if (SDL_CompareAndSwapAtomicInt(&renderer->warnedRawStructuredAccess, 0, 1)) {
+            SDL_LogWarn(
+                SDL_LOG_CATEGORY_GPU,
+                "A structured storage buffer slot is bound to a buffer without a structured view, so it accesses the raw view. Create the buffer with XDL_PROP_GPU_BUFFER_CREATE_STRIDE_NUMBER: a multiple of 4, at most 2048 and at most the buffer's size.");
+        }
+    }
+
+    return readWrite ? buffer->uavDescriptor.cpuHandle : buffer->srvDescriptor.cpuHandle;
+}
