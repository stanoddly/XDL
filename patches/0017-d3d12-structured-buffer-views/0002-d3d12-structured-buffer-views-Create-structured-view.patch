+// The storage buffer slots a property marks as structured, one bit per slot. A negative value marks none.
+static Uint32 D3D12_INTERNAL_GetStructuredSlots(SDL_PropertiesID props, const char *name)
+{
+    Sint64 slots = SDL_GetNumberProperty(props, name, 0);
+    if (slots < 0) {
+        return 0;
+    }
+
+    return (Uint32)(slots & ((1u << MAX_STORAGE_BUFFERS_PER_STAGE) - 1));
+}
