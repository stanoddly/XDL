+// Direct3D 12 limits a structured view's stride. A buffer with another stride, or smaller than one element, keeps only its raw views.
+static bool D3D12_INTERNAL_IsStructuredStride(Uint32 size, Uint32 stride)
+{
+    return stride > 0 &&
+           stride % 4 == 0 &&
+           stride <= D3D12_REQ_MULTI_ELEMENT_STRUCTURE_SIZE_IN_BYTES &&
+           size >= stride;
+}
