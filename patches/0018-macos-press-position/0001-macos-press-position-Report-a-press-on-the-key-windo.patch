From: botoddly <250804054+botoddly@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:42:42 +0100
Subject: [PATCH] macos-press-position: Report a press on the key window at its
 own place

---
 src/video/cocoa/SDL_cocoawindow.m | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/video/cocoa/SDL_cocoawindow.m b/src/video/cocoa/SDL_cocoawindow.m
index ecd35cbd508b2f462e62713d6cc8f0998195d3c8..6081c0ee326b3f8c5dce9e5eeee2603ec3989b49 100644
--- a/src/video/cocoa/SDL_cocoawindow.m
+++ b/src/video/cocoa/SDL_cocoawindow.m
@@ -1767,6 +1767,16 @@ static void Cocoa_SendMouseButtonClicks(SDL_Mouse *mouse, NSEvent *theEvent, SDL
     //  event for the background window, this just makes sure the button is reported at the
     //  correct position in its own event.
     if (focus && ([theEvent window] == ((__bridge SDL_CocoaWindowData *)focus->internal).nswindow)) {
+        /* The stored position can be another window's, or stale where no motion arrived, as over another window of the app above
+           this one. Move to the button's own position first, as X11 does, so the button names this window and its place. A button
+           outside the window, such as a release after a drag, keeps the position that motion left. */
+        const NSPoint point = [theEvent locationInWindow];
+        const float x = (float)point.x;
+        const float y = (float)(window->h - point.y);
+        if (!mouse->relative_mode && x >= 0.0f && y >= 0.0f && x < (float)window->w && y < (float)window->h &&
+            (mouse->focus != window || x != mouse->x || y != mouse->y)) {
+            SDL_SendMouseMotion(Cocoa_GetEventTimestamp([theEvent timestamp]), window, mouseID, false, x, y);
+        }
         //SDL_SendMouseButtonClicks(Cocoa_GetEventTimestamp([theEvent timestamp]), window, mouseID, button, down, clicks);
         SDL_SendMouseButton(Cocoa_GetEventTimestamp([theEvent timestamp]), window, mouseID, button, down);
     } else {
